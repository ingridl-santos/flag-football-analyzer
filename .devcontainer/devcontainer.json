{
  "name": "react-ts-template",
  "dockerComposeFile": [ "docker-compose.yml" ],
  "service": "app",
  "workspaceFolder": "/app",
  "postCreateCommand": "git config --system --add safe.directory ${containerWorkspaceFolder}; ./generate_environment.sh \"PUBLIC_*\" ./public/environment.js; npm run prepare",
  "containerEnv": {
    "NODE_ENV": "development",
    "PUBLIC_NODE_ENV": "development"
  },
  "customizations": {
    "vscode": {
      "settings": {
        "remote.localPortHost": "allInterfaces",
        "eslint.format.enable": true,
        "eslint.validate": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact"
        ],
        "editor.tabSize": 2,
        "chat.tools.terminal.terminalProfile.linux": {
          "path": "/bin/ash"
        }
      },
      "extensions": [
        "dbaeumer.vscode-eslint",
        "stylelint.vscode-stylelint",
        "vitest.explorer",
        "editorconfig.editorconfig"
      ]
    }
  }
}
